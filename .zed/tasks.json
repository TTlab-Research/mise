{
  "tasks": {
    "mise: generate python config": {
      "label": "mise: Generate Python config",
      "command": "cp",
      "args": ["examples/python-uv.toml", "mise.toml"],
      "cwd": "${workspaceRoot}"
    },
    "mise: generate nextjs config": {
      "label": "mise: Generate Next.js + Python config",
      "command": "cp",
      "args": ["examples/nextjs-fullstack.toml", "mise.toml"],
      "cwd": "${workspaceRoot}"
    },
    "mise: generate go config": {
      "label": "mise: Generate Go config",
      "command": "cp",
      "args": ["examples/go-minimal.toml", "mise.toml"],
      "cwd": "${workspaceRoot}"
    },
    "mise: generate rust config": {
      "label": "mise: Generate Rust config",
      "command": "cp",
      "args": ["examples/rust-release.toml", "mise.toml"],
      "cwd": "${workspaceRoot}"
    }
  }
}
